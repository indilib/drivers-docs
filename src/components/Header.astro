---
// Two bars, like forum.indilib.org:
// - the indilib.org header, same size and layout as on indilib.org, with Drivers marked as current
// - a full-width location bar: where the page is (Driver Categories › Cameras › ZWO) and the search
// Styles are in src/styles/indi-header.css.
import Search from "virtual:starlight/components/Search";
import { locationOf } from "../utils/location";

const INDI = "https://indilib.org";
const LINKS = [
  ["About", `${INDI}/about.html`],
  ["Tutorials", `${INDI}/tutorials.html`],
  ["Develop", `${INDI}/develop.html`],
  ["Download", `${INDI}/download.html`],
  ["Support", `${INDI}/support.html`],
];
const trail = locationOf(Astro.url.pathname, Astro.locals.starlightRoute.entry.data.title);
---
<div class="indi-head">
  <div class="indi-wrap">
    <a class="indi-brand" href={`${INDI}/`} aria-label="INDI home">
      <img src="/img/indi-logo.webp" alt="" width="38" height="38" />
      <span><b>INDI</b><small>Open Astronomy Instrumentation</small></span>
    </a>
    <nav class="indi-nav" id="indi-nav" aria-label="Main">
      {LINKS.map(([label, href]) => <a href={href}>{label}</a>)}
      <a href="/" aria-current="page">Drivers</a>
      <a class="ext" href="https://forum.indilib.org">Forum</a>
    </nav>
    <a class="indi-cta" href={`${INDI}/download.html`}>Get INDI</a>
    <button class="indi-burger" id="indi-burger" type="button" aria-expanded="false" aria-controls="indi-nav" title="Menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
  </div>
</div>

<div class="indi-sub">
  <nav class="indi-trail" aria-label="You are here">
    <ol>
      {trail.map((c) => (
        <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
      ))}
    </ol>
  </nav>
  <div class="indi-search print:hidden"><Search /></div>
</div>

<script>
  // Site menu on narrow screens. While it is open, Starlight's driver list button is hidden
  // (indi-header.css), as it would sit on top of the menu.
  const burger = document.getElementById("indi-burger")!;
  const nav = document.getElementById("indi-nav")!;
  const setOpen = (open: boolean) => {
    nav.classList.toggle("open", open);
    burger.setAttribute("aria-expanded", String(open));
    document.documentElement.toggleAttribute("data-indi-menu-open", open);
  };
  burger.addEventListener("click", () => setOpen(!nav.classList.contains("open")));
  nav.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).tagName === "A") setOpen(false);
  });
</script>
